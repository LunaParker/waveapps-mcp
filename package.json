{
  "name": "waveapps-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Wave (waveapps.com) — drives invoices, customers, estimates, bills, and receipts via the internal Wave API.",
  "type": "module",
  "license": "MIT",
  "author": "Luna Parker <100833422+LunaParker@users.noreply.github.com>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunaParker/waveapps-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/LunaParker/waveapps-mcp/issues"
  },
  "homepage": "https://github.com/LunaParker/waveapps-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wave",
    "waveapps",
    "wave-accounting",
    "accounting",
    "invoicing",
    "claude",
    "anthropic",
    "ai-tools",
    "typescript"
  ],
  "bin": {
    "waveapps-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:signed-in": "vitest run --config vitest.live.config.ts --mode signed-in",
    "test:live:writes": "vitest run --config vitest.live.config.ts --mode writes",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "node scripts/install-git-hooks.mjs",
    "check-secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^2.1.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
